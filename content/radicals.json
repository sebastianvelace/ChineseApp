      "id": "rad-ren",
      "hanzi": "人",
      "variant": "亻",
      "pinyin": "rén",
      "gloss": {
        "en": "person",
        "es": "persona"
      },
      "hint": {
        "en": "A person at the left of a character often marks a word about people.",
        "es": "Una persona a la izquierda suele marcar palabras de gente."
      },
      "exampleCharacters": [
        "作",
        "你",
        "人",
        "候",
        "他",
        "们",
        "住",
        "做"
      ]
    },
